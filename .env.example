# PostgreSQL (external). The user must own the database: the first start
# creates the extensions citext, pgcrypto, btree_gist, pg_trgm, fuzzystrmatch.
DATABASE_URL=postgres://yartt:yartt@localhost:5432/yartt

# Address users open the system at (used in sign-in links).
PUBLIC_URL=http://localhost:5173

PORT=3000

# all | api | worker
ROLE=all

# Email for every message (sign-in links, invites, notifications).
# smtp://user:password@host:587 or smtps://user:password@host:465
SMTP_URL=
MAIL_FROM=yartt <noreply@example.com>

# Optional webhook for other channels (Telegram, Slack, ...).
WEBHOOK_URL=
WEBHOOK_SECRET=

# With neither SMTP_URL nor WEBHOOK_URL messages are logged — handy for development.

# false for development over http.
COOKIE_SECURE=false

# First employee. Used only while the database has no employees.
FIRST_EMPLOYEE_EMAIL=first@example.com
FIRST_EMPLOYEE_NAME=First Employee
FIRST_EMPLOYEE_LOCALE=ru
FIRST_EMPLOYEE_TIME_ZONE=Europe/Moscow
