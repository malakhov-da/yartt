# PostgreSQL (external). The user must own the database: the first start
# creates the extensions citext, pgcrypto, btree_gist, pg_trgm.
DATABASE_URL=postgres://yartt:yartt@localhost:5432/yartt

# Address users open the system at (used in sign-in links).
PUBLIC_URL=http://localhost:5173

PORT=3000

# all | api | worker
ROLE=all

# Outgoing webhook for every message (sign-in links, notifications).
# Without WEBHOOK_URL messages are logged, which is handy for development.
WEBHOOK_URL=
WEBHOOK_SECRET=

# false for development over http.
COOKIE_SECURE=false

# First employee. Used only while the database has no employees.
FIRST_EMPLOYEE_EMAIL=first@example.com
FIRST_EMPLOYEE_NAME=First Employee
FIRST_EMPLOYEE_LOCALE=ru
FIRST_EMPLOYEE_TIME_ZONE=Europe/Moscow
