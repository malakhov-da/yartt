# A yartt trial in Docker: copy to demo.env, then
#   docker run -d --name yartt-demo -p 3000:3000 --env-file demo.env yartt/public:<version>
# and open PUBLIC_URL. There is no sign-in: pick whom to see the interface as.
#
# Give the demo a database of its own, never one with real data. Every start
# and every night wipe the demo and seed it afresh (its days are around
# today); a database holding real data is refused and left untouched.
#
# A public demo: serve it over HTTPS, set PUBLIC_URL to its address and drop
# COOKIE_SECURE below.

# PostgreSQL 16+ (external), an empty database the user owns.
DATABASE_URL=postgres://yartt:<password>@<host>:5432/yartt_demo

# The address the demo is opened at.
PUBLIC_URL=http://localhost:3000

# Plain HTTP on localhost: cookies without the Secure flag.
COOKIE_SECURE=false

# The demo company's language: ru or en.
DEMO_DATA=en
