{
  "name": "yartt",
  "version": "0.4.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#shared/*": "./shared/*",
    "#client/*": "./client/*"
  },
  "scripts": {
    "dev": "concurrently -n server,client \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite client",
    "build": "vite build client",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p . && tsc -p client",
    "test": "vitest run",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "fixture": "node --env-file-if-exists=.env scripts/fixture.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@trpc/server": "11.19.0",
    "cookie": "1.1.1",
    "express": "5.3.0",
    "nodemailer": "7.0.13",
    "openid-client": "6.8.8",
    "postgres": "3.4.9",
    "sanitize-html": "2.18.1",
    "superjson": "2.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@mui/x-charts": "8.29.3",
    "@playwright/test": "1.64.1",
    "@tanstack/react-query": "5.104.2",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@trpc/client": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "7.0.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.5",
    "i18next": "25.10.10",
    "mui-tiptap": "1.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "15.7.4",
    "react-router": "7.18.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "zustand": "5.0.15"
  }
}
